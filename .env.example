# Copy this file to `.env` for local development. `.env` is git-ignored.

# Leave unset locally to use a SQLite file (backend/local.db).
# On Vercel this is set automatically when you add the Neon database.
# DATABASE_URL=postgresql://user:password@host/dbname

WEIGHT_UNIT=lb

# Login. Any values work locally; on Vercel set real ones in Settings ->
# Environment Variables. If either is missing, every login is refused.
APP_PASSWORD=dev-password
SESSION_SECRET=dev-secret-change-me

# Phase 2 (WHOOP). Set these in Vercel's Environment Variables, never in code.
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:8000/auth/whoop/callback
